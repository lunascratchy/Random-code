<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auracle_bt</name>
  <version>0.1.0</version>
  <description>Behaviour-tree mission runner: sends routes to Nav2 (NavigateThroughPoses)</description>
  <maintainer email="amykibara45@gmail.com">auracle</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>auracle_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>