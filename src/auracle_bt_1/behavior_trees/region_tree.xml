<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="RegionTree">
  <!-- Launch -> wait for Nav2 -> set the start pose from `start` in regions.yaml (robot parked where mapping began, no click).
       Then forever: wait for a region number N -> LOAD N -> pause -> OFFLOAD N -> HOME -> turn to the
       start heading -> wait for the next N. A failed leg is skipped and the robot still goes home.
       Regions come from config/regions.yaml (fill it once with mark:=true). -->
  <BehaviorTree ID="RegionTree">
    <Sequence name="Mission">
      <WaitForNav2 need_amcl="false"/>
      <SetInitialPose file="{route_file}"/>
      <Repeat num_cycles="-1">
        <Sequence name="OneRegion">
          <WaitForRegion load_key="{load_key}" offload_key="{offload_key}"/>
          <ForceSuccess>
            <Sequence name="Trip">
              <LoadWaypoints file="{route_file}" path_name="{load_key}" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
              <Sleep msec="3000"/>   <!-- stands in for loading -->
              <LoadWaypoints file="{route_file}" path_name="{offload_key}" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
            </Sequence>
          </ForceSuccess>
          <ForceSuccess>
            <Sequence name="Home">
              <LoadWaypoints file="{route_file}" path_name="home" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
              <FaceHeading file="{route_file}" path_name="home"/>
            </Sequence>
          </ForceSuccess>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>