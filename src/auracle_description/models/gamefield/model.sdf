<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="field_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- VISUAL: full-detail original mesh, exactly as exported from CAD.
           Only used for rendering — never touched by the physics engine. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/gamefield_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.6 0.6 0.63 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- COLLISION: 26 convex hulls generated from the same STL via CoACD
           (convex decomposition), re-exported as binary STL (not OBJ) so
           every triangle carries its own valid normal. dartsim's
           CustomMeshShape loader rejects OBJ submeshes whose vertex count
           doesn't match their normal count — STL sidesteps that entirely
           since a facet normal is part of the format, not a separate
           lookup table. -->

      <collision name="collision_00">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/collision/hull_00.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e8</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name="collision_01">
