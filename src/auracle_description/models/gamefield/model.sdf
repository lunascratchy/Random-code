<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="field_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/gamefield_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.6 0.6 0.63 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- FLOOR: single flat box, exact dimensions. -->
      <collision name="floor_collision">
        <pose>0 0 0.009000 0 0 0</pose>
        <geometry>
          <box>
            <size>6.030786 3.062056 0.018000</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>

      <!-- RAMPS + WALLS: collision_ramp_0/1 are the two hill/ramp
           features, built as EXACT extruded-trapezoid solids straight
           from measured CAD coordinates (verified perfectly convex,
           volume/hull ratio = 1.0000) -- no CoACD approximation, because
           CoACD's internal voxel remesh (resolution=50 by default) was
           overshooting real geometry by 15-30mm, which is fatal on a
           feature with only 50mm of total rise. Everything else (wall_*)
           is CoACD-decomposed as before -- that slop is negligible on
           walls hundreds of mm tall. -->

      <collision name="ramp_collision_00">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/collision/collision_ramp_0.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
