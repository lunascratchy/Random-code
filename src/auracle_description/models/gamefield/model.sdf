<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="field_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- VISUAL: full-detail original mesh, unmodified. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/gamefield_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.6 0.6 0.63 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- FLOOR COLLISION: one flat box, not a mesh. The drivable surface
           is genuinely flat (18mm slab), so it gets an exact box primitive
           instead of several approximate convex hulls stitched together.
           This is what was causing the rough/uneven driving: the previous
           version split the floor itself into 9 separate convex chunks
           that met in seams directly under the wheels. A single box has
           no seams to cross. -->
      <collision name="floor_collision">
        <pose>0 0 0.009000 0 0 0</pose>
        <geometry>
          <box>
            <size>6.030786 3.062056 0.018000</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>

      <!-- WALL COLLISION: 28 convex hulls, decomposed (via CoACD) only from
           the geometry ABOVE the floor's top surface (z >= 18mm). Because
           the floor was excluded before decomposition, none of these hulls
           needs to touch the driving surface -- they only need to overlap
           the floor box itself (same rigid link, so overlap here is just a
           bit of redundant volume, not a seam or a competing body). -->

      <collision name="wall_collision_00">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/collision/wall_00.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
      <collision name="wall_collision_01">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/collision/wall_01.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
      <collision name="wall_collision_02">
